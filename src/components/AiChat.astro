---
---

<div class="ai-chat" data-ai-chat>
  <button
    class="ai-chat-ask"
    type="button"
    aria-expanded="false"
    aria-controls="ai-chat-panel"
    data-ai-chat-toggle
  >
    Ask AI
  </button>

  <div class="ai-chat-backdrop" data-ai-chat-backdrop hidden></div>

  <section
    id="ai-chat-panel"
    class="ai-chat-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ai-chat-title"
    hidden
    data-ai-chat-panel
  >
    <header class="ai-chat-header">
      <p class="ai-chat-eyebrow" id="ai-chat-title">Design system assistant</p>
      <button class="ai-chat-close" type="button" data-ai-chat-close aria-label="Close assistant">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <path
            d="M6.5 6.5l11 11M17.5 6.5l-11 11"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    <div class="ai-chat-body" data-ai-chat-body>
      <div class="ai-chat-empty" data-ai-chat-empty>
        <h2 class="ai-chat-prompt">What can I help you with?</h2>
        <ul class="ai-chat-suggestions">
          <li>
            <button type="button" data-ai-suggestion="When should a variant become a new component?">
              <span class="ai-chat-suggestion-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                  <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.5"></circle>
                  <path
                    d="M12 10.5v5M12 8.25h.01"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
                </svg>
              </span>
              Ask a question
            </button>
          </li>
          <li>
            <button type="button" data-ai-suggestion="Explain primitive vs semantic design tokens.">
              <span class="ai-chat-suggestion-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                  <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.5"></circle>
                  <path
                    d="M16 16l3.5 3.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
                </svg>
              </span>
              Find a token concept
            </button>
          </li>
          <li>
            <button
              type="button"
              data-ai-suggestion="What accessibility checks should I run before shipping a component?"
            >
              <span class="ai-chat-suggestion-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                  <path
                    d="M7 4.75h10A2.25 2.25 0 0 1 19.25 7v10A2.25 2.25 0 0 1 17 19.25H7A2.25 2.25 0 0 1 4.75 17V7A2.25 2.25 0 0 1 7 4.75Z"
                    stroke="currentColor"
                    stroke-width="1.5"></path>
                  <path
                    d="M8.5 9.5h7M8.5 12.5h7M8.5 15.5h4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
                </svg>
              </span>
              Build a pre-ship checklist
            </button>
          </li>
        </ul>
      </div>

      <div class="ai-chat-messages" data-ai-chat-messages aria-live="polite" hidden></div>
    </div>

    <div class="ai-chat-composer">
      <form class="ai-chat-form" data-ai-chat-form>
        <label class="visually-hidden" for="ai-chat-input">Ask about the design system</label>
        <input
          id="ai-chat-input"
          class="ai-chat-input"
          name="message"
          type="text"
          autocomplete="off"
          enterkeyhint="send"
          maxlength="2000"
          placeholder="Ask about tokens, components, a11y…"
          data-ai-chat-input
        />
        <button class="ai-chat-send" type="submit" data-ai-chat-send aria-label="Send">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <path
              d="M12 18.5V5.5M12 5.5l-5 5M12 5.5l5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </form>
      <p class="ai-chat-status" data-ai-chat-status role="status" hidden></p>
    </div>
  </section>
</div>

<style>
  .ai-chat {
    --ai-sheet-offset: 0px;
    font-family: var(--font-ui);
    z-index: 50;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ai-chat-ask {
    position: fixed;
    inset-inline-end: max(1rem, env(safe-area-inset-right));
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    z-index: 51;
    appearance: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 0.7rem 1.15rem;
    cursor: pointer;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--ink) 14%, transparent);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      opacity 160ms ease;
  }

  .ai-chat-ask:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 32px color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .ai-chat-ask[aria-expanded='true'],
  .ai-chat[data-open] .ai-chat-ask {
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem);
  }

  .ai-chat-backdrop {
    position: fixed;
    inset: 0;
    z-index: 52;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    animation: ai-fade-in 200ms ease;
  }

  .ai-chat-backdrop[hidden] {
    display: none;
  }

  .ai-chat-panel {
    position: fixed;
    inset-inline: 0;
    inset-block-end: var(--ai-sheet-offset);
    z-index: 53;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-height: min(78dvh, calc(100dvh - var(--ai-sheet-offset) - 0.75rem));
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 22px 22px 0 0;
    box-shadow: 0 -18px 48px color-mix(in srgb, var(--ink) 16%, transparent);
    overflow: hidden;
    transform: translateY(0);
    animation: ai-sheet-in 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-chat-panel[hidden] {
    display: none;
  }

  @keyframes ai-sheet-in {
    from {
      opacity: 0.6;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ai-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.9rem 1.1rem 0.55rem;
    flex-shrink: 0;
  }

  .ai-chat-eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-soft);
  }

  .ai-chat-close {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: var(--bg-code);
    color: var(--ink);
    cursor: pointer;
  }

  .ai-chat-close:hover {
    background: color-mix(in srgb, var(--accent) 16%, var(--bg-code));
  }

  .ai-chat-body {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .ai-chat-empty {
    padding: 1.25rem 1.25rem 0.75rem;
  }

  .ai-chat-prompt {
    margin: 0 0 1.25rem;
    padding: 0;
    border: 0;
    font-size: clamp(1.5rem, 4.5vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  .ai-chat-suggestions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .ai-chat-suggestions button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    text-align: left;
    padding: 0.85rem 0.15rem;
    cursor: pointer;
    border-radius: 10px;
  }

  .ai-chat-suggestions button:hover {
    background: color-mix(in srgb, var(--bg-code) 80%, transparent);
  }

  .ai-chat-suggestion-icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .ai-chat-messages {
    padding: 0.35rem 1.15rem 1rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ai-chat-messages[hidden] {
    display: none;
  }

  .ai-chat-bubble {
    max-width: 92%;
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    font-size: 0.975rem;
    line-height: 1.5;
  }

  .ai-chat-bubble p {
    margin: 0;
    font-family: var(--font-body);
  }

  .ai-chat-bubble p + p {
    margin-top: 0.55rem;
  }

  .ai-chat-bubble-assistant {
    align-self: flex-start;
    background: var(--bg-code);
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .ai-chat-bubble-user {
    align-self: flex-end;
    background: color-mix(in srgb, var(--accent) 14%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line));
    color: var(--ink);
  }

  .ai-chat-bubble-pending {
    color: var(--ink-soft);
    font-style: italic;
  }

  .ai-chat-composer {
    flex-shrink: 0;
    padding: 0.65rem 1rem calc(0.85rem + env(safe-area-inset-bottom));
    border-top: 1px solid transparent;
    background: var(--bg-raised);
  }

  .ai-chat-form {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 3.1rem;
    padding: 0.35rem 0.4rem 0.35rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
  }

  .ai-chat-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    padding: 0.55rem 0;
  }

  .ai-chat-input::placeholder {
    color: var(--ink-soft);
  }

  .ai-chat-send {
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--white);
    cursor: pointer;
  }

  .ai-chat-send:hover:not(:disabled) {
    background: var(--accent-strong);
  }

  .ai-chat-send:disabled,
  .ai-chat-input:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .ai-chat-status {
    margin: 0.55rem 0.35rem 0;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .ai-chat-status[data-tone='error'] {
    color: #a33b2d;
  }

  @media (prefers-color-scheme: dark) {
    .ai-chat-ask {
      background: var(--bg-raised);
      color: var(--ink);
    }

    .ai-chat-send {
      color: #102422;
    }

    .ai-chat-status[data-tone='error'] {
      color: #f0a090;
    }
  }

  @media (min-width: 860px) {
    .ai-chat-panel {
      inset-inline: auto;
      inset-inline-end: max(1rem, env(safe-area-inset-right));
      width: min(28rem, calc(100vw - 2rem));
      max-height: min(40rem, calc(100dvh - var(--ai-sheet-offset) - 1.5rem));
      border-radius: 22px;
      border-bottom: 1px solid var(--line);
      margin-bottom: max(1rem, env(safe-area-inset-bottom));
    }

    .ai-chat-composer {
      padding-bottom: 0.95rem;
    }
  }
</style>

<script>
  type ChatTurn = { role: 'user' | 'assistant'; content: string };

  const root = document.querySelector<HTMLElement>('[data-ai-chat]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-ai-chat-toggle]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-ai-chat-close]');
    const backdrop = root.querySelector<HTMLElement>('[data-ai-chat-backdrop]');
    const panel = root.querySelector<HTMLElement>('[data-ai-chat-panel]');
    const form = root.querySelector<HTMLFormElement>('[data-ai-chat-form]');
    const input = root.querySelector<HTMLInputElement>('[data-ai-chat-input]');
    const sendBtn = root.querySelector<HTMLButtonElement>('[data-ai-chat-send]');
    const messagesEl = root.querySelector<HTMLElement>('[data-ai-chat-messages]');
    const emptyEl = root.querySelector<HTMLElement>('[data-ai-chat-empty]');
    const bodyEl = root.querySelector<HTMLElement>('[data-ai-chat-body]');
    const statusEl = root.querySelector<HTMLElement>('[data-ai-chat-status]');
    const suggestionBtns = root.querySelectorAll<HTMLButtonElement>('[data-ai-suggestion]');

    const history: ChatTurn[] = [];
    let open = false;
    let pending = false;
    let previousOverflow = '';

    function setStatus(text: string, tone: 'info' | 'error' = 'info') {
      if (!statusEl) return;
      if (!text) {
        statusEl.hidden = true;
        statusEl.textContent = '';
        statusEl.removeAttribute('data-tone');
        return;
      }
      statusEl.hidden = false;
      statusEl.textContent = text;
      statusEl.dataset.tone = tone;
    }

    function syncKeyboardOffset() {
      const vv = window.visualViewport;
      if (!vv || !open) {
        root.style.setProperty('--ai-sheet-offset', '0px');
        return;
      }
      const occluded = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
      root.style.setProperty('--ai-sheet-offset', `${occluded}px`);
    }

    function setOpen(next: boolean, { focusInput = true }: { focusInput?: boolean } = {}) {
      open = next;
      if (!toggle || !panel || !backdrop) return;

      toggle.setAttribute('aria-expanded', String(open));
      root.toggleAttribute('data-open', open);
      panel.hidden = !open;
      backdrop.hidden = !open;

      if (open) {
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        syncKeyboardOffset();
        if (focusInput) {
          // Defer so the sheet can paint before the mobile keyboard rises.
          requestAnimationFrame(() => input?.focus());
        }
      } else {
        document.body.style.overflow = previousOverflow;
        root.style.setProperty('--ai-sheet-offset', '0px');
        toggle.focus();
      }
    }

    function showConversation() {
      if (emptyEl) emptyEl.hidden = true;
      if (messagesEl) messagesEl.hidden = false;
    }

    function appendBubble(role: 'user' | 'assistant', content: string, pendingBubble = false) {
      if (!messagesEl) return null;
      showConversation();
      const bubble = document.createElement('div');
      bubble.className = `ai-chat-bubble ai-chat-bubble-${role}${pendingBubble ? ' ai-chat-bubble-pending' : ''}`;
      bubble.dataset.role = role;
      const p = document.createElement('p');
      p.textContent = content;
      bubble.appendChild(p);
      messagesEl.appendChild(bubble);
      bodyEl && (bodyEl.scrollTop = bodyEl.scrollHeight);
      return bubble;
    }

    function renderAssistantText(bubble: HTMLElement, text: string) {
      bubble.classList.remove('ai-chat-bubble-pending');
      bubble.replaceChildren();
      const parts = text.split(/\n{2,}/);
      for (const part of parts) {
        const p = document.createElement('p');
        p.textContent = part.replace(/\n/g, ' ').trim();
        if (p.textContent) bubble.appendChild(p);
      }
      bodyEl && (bodyEl.scrollTop = bodyEl.scrollHeight);
    }

    async function sendMessage(content: string) {
      if (!input || pending) return;
      const text = content.trim();
      if (!text) return;

      setStatus('');
      input.value = '';
      appendBubble('user', text);
      history.push({ role: 'user', content: text });

      const thinking = appendBubble('assistant', 'Thinking…', true);
      pending = true;
      if (sendBtn) sendBtn.disabled = true;
      input.disabled = true;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });

        const data = (await res.json().catch(() => ({}))) as { reply?: string; error?: string };
        if (!res.ok || !data.reply) {
          thinking?.remove();
          history.pop();
          setStatus(data.error || 'Something went wrong. Try again.', 'error');
          return;
        }

        if (thinking) renderAssistantText(thinking, data.reply);
        history.push({ role: 'assistant', content: data.reply });
      } catch {
        thinking?.remove();
        history.pop();
        setStatus('Network error. Check your connection and try again.', 'error');
      } finally {
        pending = false;
        if (sendBtn) sendBtn.disabled = false;
        input.disabled = false;
        input.focus();
      }
    }

    toggle?.addEventListener('click', () => setOpen(true, { focusInput: false }));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) {
        event.preventDefault();
        setOpen(false);
      }
    });

    for (const btn of suggestionBtns) {
      btn.addEventListener('click', () => {
        const suggestion = btn.dataset.aiSuggestion ?? '';
        if (!suggestion) return;
        void sendMessage(suggestion);
      });
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      void sendMessage(input?.value ?? '');
    });

    const vv = window.visualViewport;
    vv?.addEventListener('resize', syncKeyboardOffset);
    vv?.addEventListener('scroll', syncKeyboardOffset);
    window.addEventListener('resize', syncKeyboardOffset);
  }
</script>
