---
import '../styles/global.css';
import AiChat from '../components/AiChat.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A working reference for owning a design system as a UX engineer.' } = Astro.props;

const nav = [
  {
    group: 'System',
    items: [
      { href: '/', label: 'Start here' },
      { href: '/foundation/', label: 'Foundation' },
      { href: '/tokens/', label: 'Tokens' },
      { href: '/components/', label: 'Components' },
      { href: '/patterns/', label: 'Patterns' },
      { href: '/accessibility/', label: 'Accessibility' },
      { href: '/guidance/', label: 'Guidance' },
      { href: '/governance/', label: 'Governance' },
    ],
  },
  {
    group: 'Working',
    items: [
      { href: '/checklist/', label: 'Pre-code checklist' },
      { href: '/resources/', label: 'Resources' },
    ],
  },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · DS Field Manual</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="sidebar">
        <div class="sidebar-inner">
          <div class="sidebar-head">
            <a class="wordmark" href="/">Field<span>Manual</span></a>
            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
              Menu
            </button>
          </div>
          <p class="role-line">Design system reference for UX engineering</p>
          <nav id="site-nav" class="site-nav" aria-label="Main">
            {
              nav.map((section) => (
                <>
                  <p class="nav-group">{section.group}</p>
                  <ul>
                    {section.items.map((item) => (
                      <li>
                        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ))
            }
          </nav>
        </div>
      </header>
      <main id="main">
        <div class="content">
          <slot />
        </div>
      </main>
    </div>
    <AiChat />
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const navEl = document.getElementById('site-nav');
      if (toggle && navEl) {
        toggle.addEventListener('click', () => {
          const open = navEl.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      }
    </script>
  </body>
</html>
